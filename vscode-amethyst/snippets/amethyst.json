{
  "main": {
    "prefix": "main",
    "body": [
      "fn main() -> int {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "Program entry point"
  },
  "function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:arg}: ${3:int}) -> ${4:int} {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "Function declaration"
  },
  "void function": {
    "prefix": "fnvoid",
    "body": [
      "fn ${1:name}(${2:arg}: ${3:int}) -> void {",
      "\t$0",
      "}"
    ],
    "description": "Function that returns nothing"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:int}",
      "}"
    ],
    "description": "Struct declaration"
  },
  "impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Name} {",
      "\tfn ${2:method}(self: ${1:Name}${3:, arg: int}) -> ${4:void} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Impl block with a method"
  },
  "new object": {
    "prefix": "new",
    "body": ["new ${1:Name} { ${2:field}: ${3:0} }$0"],
    "description": "Allocate a struct on the heap"
  },
  "new array": {
    "prefix": "newarr",
    "body": ["var ${1:a}: ${2:int}[] = new ${2:int}[${3:n}];$0"],
    "description": "Heap array with a runtime length"
  },
  "empty array": {
    "prefix": "emptyarr",
    "body": ["var ${1:a}: ${2:int}[] = [];$0"],
    "description": "Empty growable array (push fills it)"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "if statement"
  },
  "if/else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if/else statement"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "while loop"
  },
  "for range": {
    "prefix": "for",
    "body": [
      "for ${1:i} in 0..${2:n} {",
      "\t$0",
      "}"
    ],
    "description": "for loop over a range"
  },
  "print": {
    "prefix": "print",
    "body": ["print(${1:expr});$0"],
    "description": "Print one value"
  },
  "push/pop": {
    "prefix": "push",
    "body": ["push(${1:a}, ${2:value});$0"],
    "description": "Append to a dynamic array"
  },
  "free": {
    "prefix": "free",
    "body": ["free(${1:p});$0"],
    "description": "Release a struct or a new array"
  }
}
