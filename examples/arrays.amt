fn main() -> int {
    // fixed-size arrays with literal initializer
    var nums: int[5] = [10, 20, 30, 40, 50];
    var flags: bool[3] = [true, false, true];

    print(nums[0]);   // 10
    print(nums[4]);   // 50
    print(flags[1]);  // 0 (false)

    // mutation through index
    nums[2] = 99;
    print(nums[2]);   // 99

    // iterate with for + index
    var total: int = 0;
    for i in 0..5 {
        total = total + nums[i];
    }
    print(total);  // 10+20+99+40+50 = 219

    // type inference
    var squares = [1, 4, 9, 16];
    print(squares[3]);  // 16

    // infer scalars too
    var x = 42;
    var ok = x > 40;
    print(x);   // 42
    print(ok);  // 1
    return 0;
}
