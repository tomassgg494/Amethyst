fn classify(n: int) -> int {
    if n < 0 {
        print(-1);
        return -1;
    } else if n == 0 {
        print(0);
        return 0;
    } else {
        print(1);
        return 1;
    }
}

fn main() -> int {
    var x: int = 10;
    var acc: int = 0;

    while x > 0 {
        if x % 2 == 0 {
            acc = acc + x;
        }
        x = x - 1;
    }
    print(acc);

    classify(-5);
    classify(0);
    classify(7);

    var ok: bool = acc > 10 && acc < 100;
    print(ok);
    print(!ok);
    return acc;
}
