// Compound assignment operators: += -= *= /= %=
fn main() -> int {
    var n = 100;
    n += 20;   // 120
    n -= 8;    // 112
    n *= 3;    // 336
    n /= 4;    // 84
    n %= 10;   // 4
    print(n);  // 4

    var a: int[4] = [1, 2, 3, 4];
    print(len(a));  // 4

    for i in 0..len(a) {
        a[i] *= 10;
        a[i] += i;
    }
    print(a[0]);  // 10
    print(a[1]);  // 21
    print(a[2]);  // 32
    print(a[3]);  // 43

    var total = 0;
    for i in 0..len(a) {
        total += a[i];
    }
    print(total);  // 106
    return 0;
}
